# Copy to .env (never commit .env). Everything except the paths is optional.

# ---- Paths on the host (Unraid defaults) ----
# GAMES_PATH must contain one folder (or archive) per game, e.g. /mnt/user/space/games/roms/pc
GAMES_PATH=/mnt/user/games
APPDATA_PATH=/mnt/user/appdata/game-manager
DOWNLOADS_PATH=/mnt/user/downloads
GM_PORT=8080
PUID=99
PGID=100

# ---- First admin ----
# Without these, the web UI asks you to create the admin on first visit.
GM_ADMIN_USERNAME=
GM_ADMIN_PASSWORD=

# Address people use to reach the server (needed for OIDC redirects), e.g. https://games.example.com
GM_PUBLIC_URL=

# ---- Sign in with TinyAuth (or any OIDC provider) ----
# Easier: set this up in the web UI under Admin, Connections and sign-in.
# GM_OIDC_ISSUER=https://auth.example.com
# GM_OIDC_CLIENT_ID=
# GM_OIDC_CLIENT_SECRET=
# GM_OIDC_NAME=TinyAuth
# GM_OIDC_ADMIN_GROUP=admins
# GM_OIDC_AUTO_CREATE=true

# ---- Or trust a forward-auth proxy's headers (TinyAuth forward auth) ----
# Only requests from these addresses may set the headers.
# GM_AUTH_HEADER_USER=remote-user
# GM_TRUSTED_PROXIES=172.16.0.0/12
# GM_AUTH_HEADER_ADMIN_GROUP=admins

# ---- Metadata ----
# IGDB keys from https://dev.twitch.tv/console (free). Steam and PCGamingWiki work without keys.
# These can also be set in the web UI (Admin, Connections and sign-in), which wins over these.
GM_IGDB_CLIENT_ID=
GM_IGDB_CLIENT_SECRET=
# Free keys: rawg.io/apidocs (metadata) and steamgriddb.com (covers and backgrounds)
GM_RAWG_API_KEY=
GM_STEAMGRIDDB_API_KEY=
GM_METADATA_AUTO=true

# ---- Library ----
GM_WATCH=true
GM_SCAN_INTERVAL_MINUTES=30
GM_LOG_LEVEL=info

# Optional admin token for scripts (openssl rand -hex 32). Leave empty to disable.
GM_API_TOKEN=
